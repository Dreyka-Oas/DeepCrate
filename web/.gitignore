# ---- IDE ----
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# ---- Logs ----
*.log

# ---- Secrets ----
# The site deploys to Cloudflare Pages: no token must ever be able to leave by accident
.env
.env.*
!.env.example
*.pem
*.key

# ---- Node (the tools in web/tools/ are dependency-free .mjs, but just in case) ----
node_modules/
npm-debug.log*
.npm/

# ---- Editor, merge and patch leftovers ----
*.orig
*.rej
*.swp
*.swo
*~

# ---- Local tooling, never pushed ----
.skills/
.claude/
.codex/
.superpowers/
# Local Cloudflare Wrangler cache
.wrangler/
# Local git worktrees (multi-agent runs)
/.worktrees/

# ---- OS junk ----
.DS_Store
Thumbs.db
